{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "vtubearea-model"
    },
    "format_version": {
      "type": "number",
      "const": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "display_name": {
            "type": "string"
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "default_value": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "minimum",
          "maximum",
          "default_value"
        ]
      }
    },
    "groups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "parent_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "pivot": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "bindings": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "parameter_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "keyframes": {
                  "minItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "parameter_value": {
                        "type": "number"
                      },
                      "translate": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "rotation_degrees": {
                        "type": "number"
                      },
                      "scale": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "vertex_offsets": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "parameter_value"
                    ]
                  }
                }
              },
              "required": [
                "parameter_id",
                "keyframes"
              ]
            }
          }
        },
        "required": [
          "id",
          "pivot"
        ]
      }
    },
    "layers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "parent_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "texture": {
            "type": "string",
            "minLength": 1
          },
          "rect": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "pivot": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "draw_order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "mask_layer_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "mesh": {
            "default": {
              "columns": 1,
              "rows": 1
            },
            "type": "object",
            "properties": {
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              }
            },
            "required": [
              "columns",
              "rows"
            ]
          },
          "bindings": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "parameter_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "keyframes": {
                  "minItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "parameter_value": {
                        "type": "number"
                      },
                      "translate": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "rotation_degrees": {
                        "type": "number"
                      },
                      "scale": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "vertex_offsets": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "parameter_value"
                    ]
                  }
                }
              },
              "required": [
                "parameter_id",
                "keyframes"
              ]
            }
          }
        },
        "required": [
          "id",
          "texture",
          "rect",
          "draw_order"
        ]
      }
    },
    "physics": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "input_parameter_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "output_parameter_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "stiffness": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "damping": {
            "type": "number",
            "minimum": 0
          },
          "output_scale": {
            "default": 1,
            "type": "number"
          }
        },
        "required": [
          "id",
          "input_parameter_id",
          "output_parameter_id",
          "stiffness",
          "damping"
        ]
      }
    },
    "expressions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "display_name": {
            "type": "string"
          },
          "parameter_values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "fade_seconds": {
            "default": 0.25,
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "display_name",
          "parameter_values"
        ]
      }
    },
    "hands": {
      "type": "object",
      "properties": {
        "skin_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "outline_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "outline_width": {
          "default": 4,
          "type": "number",
          "minimum": 0
        },
        "finger_width_ratio": {
          "default": 0.26,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hand_scale": {
          "default": 1,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "face_anchor": {
          "type": "object",
          "properties": {
            "center": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "group_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "center",
            "height"
          ]
        },
        "behind_head_draw_order": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "arms": {
          "type": "object",
          "properties": {
            "left_shoulder": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "right_shoulder": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "upper_arm_length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "forearm_length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "outline_color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "group_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "left_shoulder",
            "right_shoulder",
            "upper_arm_length",
            "forearm_length",
            "width",
            "color",
            "outline_color"
          ]
        }
      },
      "required": [
        "skin_color",
        "outline_color",
        "face_anchor"
      ]
    }
  },
  "required": [
    "format",
    "format_version",
    "metadata",
    "canvas",
    "parameters",
    "layers"
  ]
}
