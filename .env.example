# Copy to .env and change what you need. Every value here has a working default.
# VITE_* values are read by the desktop UI at build/dev time, VTUBEAREA_* by the Rust core at runtime.

# --- Rust core ---
# Where models, backgrounds and other user files live. Default: OS app data folder.
VTUBEAREA_DATA_DIR=
# Separate models folder, if you keep models elsewhere. Default: <data dir>/models
VTUBEAREA_MODELS_DIR=

# --- Camera ---
# Higher resolution gives MediaPipe more pixels for eyes and fingers; 640x480 saves CPU.
VITE_CAMERA_WIDTH=1280
VITE_CAMERA_HEIGHT=720
VITE_CAMERA_FRAME_RATE=30

# --- Face tracking (MediaPipe files are downloaded by `pnpm setup:assets`) ---
VITE_TRACKING_MODEL_PATH=/mediapipe/face_landmarker.task
VITE_TRACKING_WASM_PATH=/mediapipe/wasm
VITE_TRACKING_USE_GPU=true
VITE_CALIBRATION_DURATION_MS=2000
# Expression calibration: time to raise and lower brows, open the mouth wide and smile.
VITE_EXPRESSION_CALIBRATION_DURATION_MS=8000
# How long without a face before the model eases back to a neutral pose.
VITE_FACE_LOST_TIMEOUT_MS=800
# MediaPipe confidence thresholds, 0..1. Lower keeps tracking when the head turns
# far to the side, but may accept a wrong face in a busy room. MediaPipe default is 0.5.
VITE_FACE_DETECTION_CONFIDENCE=0.3
VITE_FACE_PRESENCE_CONFIDENCE=0.3
VITE_FACE_TRACKING_CONFIDENCE=0.3

# --- Hand tracking (off by default in the UI, costs extra CPU/GPU) ---
VITE_HAND_MODEL_PATH=/mediapipe/hand_landmarker.task
# New hands need a confident detection (fewer phantom hands); tracked hands stay at the lower values.
VITE_HAND_DETECTION_CONFIDENCE=0.5
VITE_HAND_PRESENCE_CONFIDENCE=0.3
VITE_HAND_TRACKING_CONFIDENCE=0.3
# How long a hand stays visible on the avatar after the camera loses it.
VITE_HAND_LOST_TIMEOUT_MS=450

# --- Idle motion ---
VITE_AUTO_BLINK_MIN_INTERVAL_MS=2500
VITE_AUTO_BLINK_MAX_INTERVAL_MS=6000
VITE_BREATHING_PERIOD_MS=3500

# --- Rendering ---
VITE_RENDER_MAX_FPS=60
VITE_RENDER_ANTIALIAS=true

# --- Interface ---
VITE_DEFAULT_LOCALE=ru
VITE_DEBUG_MODE_DEFAULT=false
# Default hotkeys (users can rebind them in Settings). KeyboardEvent.code names with
# Mod/Alt/Shift/Ctrl prefixes; Mod is Cmd on macOS and Ctrl on Windows/Linux.
VITE_HOTKEY_TOGGLE_INTERFACE=Mod+Shift+KeyH
VITE_HOTKEY_TOGGLE_DEBUG=Mod+Shift+KeyD
VITE_HOTKEY_CALIBRATE=Mod+Shift+KeyK
